# 复制到项目根目录 .env；不复制到 backend/.env。
# 默认使用项目根目录 .local-data，不需要配置任何密钥。
# 如需自定义，请换为真实的本地私有目录；不得使用公开静态目录。
# CITY_MEMORIES_DATA_DIR=D:/path/to/private/city-memories-data
CITY_MEMORIES_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
# 仅本机 HTTP 开发使用 false；未来 HTTPS 部署必须为 true。
CITY_MEMORIES_COOKIE_SECURE=false
# 可选：由密钥管理环境注入 CITY_MEMORIES_AUTH_SECRET（至少 32 字节）。
# 不配置时，服务自动生成并复用私有目录下的 auth-secret.key，不输出其内容。
# 清理随服务启动补做、运行时定期执行；不需要系统计划任务。
CITY_MEMORIES_CLEANUP_ENABLED=true
CITY_MEMORIES_CLEANUP_INTERVAL_SECONDS=60
# 地图可选：浏览器端 Key 只经认证的运行时接口提供，不写入前端构建。
# 由密钥环境注入 CITY_MEMORIES_MAP_KEY，或指定只含 TIANDITU_KEY 的本地配置文件。
# CITY_MEMORIES_MAP_KEY_FILE=D:/path/to/private/map.env
# 按官方服务当前实际信息填写；底图信息不代表本应用已通过审图。
# CITY_MEMORIES_MAP_REVIEW_NUMBER="请填当前底图审图信息"
# CITY_MEMORIES_MAP_REVIEW_DATE=YYYY-MM-DD
